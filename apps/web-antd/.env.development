# 端口号
VITE_PORT=5173

VITE_BASE=/

# 浏览器请求的接口前缀，开发时由 vite 代理转发到 API_PROXY_TARGET
VITE_GLOB_API_URL=/api

# 开发代理转发的后端地址（协议 + 主机 + 端口），本地有不同地址可写到 .env.development.local 覆盖
API_PROXY_TARGET=http://localhost:9050

# 不使用 vben 自带的 Nitro Mock，接口直接走真实后端
VITE_NITRO_MOCK=false

# 是否打开 devtools，true 为打开，false 为关闭
VITE_DEVTOOLS=false

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true
